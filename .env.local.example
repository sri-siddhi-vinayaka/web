# Copy to .env.local and fill in your Supabase project's values.
# See README.md "Supabase setup" and infra/README.md for how to apply migrations.

# Safe to expose to the browser — RLS policies are what actually protect the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely — used by /admin to read registrations and
# manage announcements/gallery. Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Shared password gating /admin — a speed bump, not authentication.
# Rotate periodically.
ADMIN_PASSWORD=
