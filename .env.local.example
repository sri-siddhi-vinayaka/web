# Copy to .env.local and fill in your Supabase project's values.
# See README.md "Supabase setup" and supabase/README.md for how to apply migrations.

# Safe to expose to the browser — RLS policies are what actually protect the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely — used by /admin to read registrations and
# manage announcements/gallery. Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Shared password gating /admin — a speed bump, not authentication.
# Rotate periodically.
ADMIN_PASSWORD=

# Server-only, both optional — without them, new Pooja registrations still
# work, they just don't email anyone (see lib/notify.ts). Free Resend
# account + API key (resend.com), and whichever address the committee
# actually checks.
RESEND_API_KEY=
ADMIN_ALERT_EMAIL=

# All three optional — without them, posting an announcement still works,
# it just doesn't push a notification (see lib/webpush.ts). Self-generated,
# no account needed: `npx web-push generate-vapid-keys`. The public key is
# safe to expose (it's sent to the browser either way, to subscribe it).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https:// URL identifying the sender, per the Web Push spec.
VAPID_SUBJECT=
